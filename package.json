{
  "name": "wispwise-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "XDG_CONFIG_HOME=$PWD/work/config XDG_CACHE_HOME=$PWD/work/cache WRANGLER_LOG_PATH=work/wrangler.log wrangler dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:test": "npm run build && vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:worker": "XDG_CONFIG_HOME=$PWD/work/config XDG_CACHE_HOME=$PWD/work/cache WRANGLER_LOG_PATH=work/wrangler.log vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=./work/playwright-browsers playwright test",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=./work/playwright-browsers playwright install chromium",
    "artwork:specs": "node scripts/export-card-artwork-specs.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "types:worker": "XDG_CONFIG_HOME=$PWD/work/config XDG_CACHE_HOME=$PWD/work/cache WRANGLER_LOG_PATH=work/wrangler.log wrangler types worker/worker-configuration.d.ts",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm run typecheck:worker && npm run test && npm run test:worker && npm run build"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wrangler": "^4.119.0"
  }
}
